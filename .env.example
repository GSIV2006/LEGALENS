# Database Configuration
# For local development: sqlite:///./legal_metrology.db
# For production (Vercel): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./legal_metrology.db

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Storage Configuration
# local: saves to uploads/ folder
# memory: stores in database (for prototypes/serverless)
# s3: for external object storage (Supabase, AWS S3, etc.)
STORAGE_MODE=local

# Environment
ENVIRONMENT=development
